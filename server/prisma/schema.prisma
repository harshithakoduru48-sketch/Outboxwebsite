datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatar    String?
  emails    Email[]
  slack     SlackIntegration?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sender {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  hourlyLimit Int      @default(200)
  active      Boolean  @default(true)
  emails      Email[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Email {
  id                 String    @id @default(uuid())
  recipientEmail     String
  subject            String
  body               String
  status             String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED, RATE_LIMITED
  scheduledAt        DateTime
  sentAt             DateTime?
  delayMs            Int       @default(0)
  etherealPreviewUrl String?
  errorReason        String?
  senderId           String
  sender             Sender    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([senderId])
}

model SlackIntegration {
  id          String   @id @default(uuid())
  webhookUrl  String?
  channel     String?
  accessToken String?
  isActive    Boolean  @default(true)
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RateLimitLog {
  id         String   @id @default(uuid())
  senderId   String
  hourWindow String   // e.g. "2026-09-06-11"
  count      Int      @default(0)
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([senderId, hourWindow])
}
